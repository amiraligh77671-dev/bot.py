        )

# ---------- بخش Telethon (سلف واقعی) ----------
user_clients = {}  # ذخیره کلاینت‌های هر کاربر

async def handle_telethon_messages(client, user_id):
    @client.on(events.NewMessage(outgoing=True))
    async def on_outgoing(event):
        s = get_user_settings(user_id)
        if not s:
            return
        text = event.raw_text
        if not text:
            return

        # تبدیل اعداد
        if s["convert_numbers"]:
            def num_to_words(n):
                words = ["صفر","یک","دو","سه","چهار","پنج","شش","هفت","هشت","نه","ده"]
                try:
                    return words[int(n)] if 0 <= int(n) <= 10 else n
                except:
                    return n
            text = re.sub(r'\d+', lambda x: num_to_words(x.group()), text)

        # اضافه کردن ساعت و تاریخ
        if s["clock"] or s["date"]:
            now = datetime.now(timezone(timedelta(hours=3, minutes=30)))
            time_str = now.strftime("%H:%M") if s["clock"] else ""
            date_str = now.strftime("%Y/%m/%d") if s["date"] else ""
            if s["clock"] and s["date"]:
                text = f"[{time_str} - {date_str}] {text}"
            elif s["clock"]:
                text = f"[{time_str}] {text}"
            elif s["date"]:
                text = f"[{date_str}] {text}"

        # ساخت entities
        entities = []
        if s["bold"]:
            entities.append(MessageEntityBold(0, len(text)))
        if s["italic"]:
            entities.append(MessageEntityItalic(0, len(text)))
        if s["underline"]:
            entities.append(MessageEntityUnderline(0, len(text)))
        if s["strike"]:
            entities.append(MessageEntityStrike(0, len(text)))
        if s["monospace"]:
            entities.append(MessageEntityCode(0, len(text)))

        # ارسال پیام با فرمت
        await event.edit(text, formatting_entities=entities)

